# Safety net for a misconfigured server whose document root is the project
# root instead of /public. The correct setup points the document root at /public.
Options -Indexes
<FilesMatch "^\.|\.(md|lock|json|sqlite|log)$|^(server|console)\.php$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
