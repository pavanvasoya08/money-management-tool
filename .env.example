# ------------------------------------------------------------------
# Business ERP — environment configuration (copy to .env and edit)
# Never commit your real .env file.
# ------------------------------------------------------------------

APP_NAME="Business ERP"
# local | staging | production
APP_ENV=production
# Must be false in production (hides stack traces)
APP_DEBUG=false
# Public base URL, no trailing slash (used in password-reset emails)
APP_URL=https://erp.example.com

# Encryption key for sensitive fields such as bank account numbers.
# Create it once with: php bin/console key:generate  (keep it secret and backed up)
APP_KEY=
APP_TIMEZONE=Asia/Kolkata
# Comma-separated proxy IPs whose X-Forwarded-For header is trusted (leave empty if none)
TRUSTED_PROXIES=

# ---------------- Database (MySQL 8.0+) ----------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=business_erp
DB_USERNAME=erp_user
DB_PASSWORD=change-me

# ---------------- Session & cookies ----------------
SESSION_NAME=erp_session
# Absolute lifetime in minutes (idle timeout is set in Settings)
SESSION_LIFETIME=480
# true when served over HTTPS (required in production)
SESSION_SECURE_COOKIE=true
# Lax | Strict
SESSION_SAME_SITE=Lax

# ---------------- Mail (password reset) ----------------
# log  = write emails to storage/logs/mail.log (development)
# mail = PHP mail() via the server's sendmail/MTA
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Business ERP"
